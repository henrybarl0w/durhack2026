From 559fe2efb4a1cd7fca85fa3239fd2420df8cda54 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 15 Nov 2026 10:09:48 +0000
Subject: [PATCH] Hide the Scan tab's debugging unless asked for

The chorale and corrections line, the problems found, the notes read, reader
warnings and the MIDI of the reading are hidden. ?debug=1 on the address shows
them, and CHORALE_DEBUG=1 shows them to everyone. Nothing is removed.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01P4k8UPST5WcK4Fy4Yoyr5Y
---
 webapp/README.md            |  2 ++
 webapp/app.py               |  8 ++++++++
 webapp/templates/index.html | 16 +++++++++-------
 3 files changed, 19 insertions(+), 7 deletions(-)

diff --git a/webapp/README.md b/webapp/README.md
index d910af8..a21f26b 100644
--- a/webapp/README.md
+++ b/webapp/README.md
@@ -17,6 +17,8 @@ Scan tab (`webapp/scanner.py`): the browser sends a camera frame every 250 ms to
 
 The notes then go through `decodeReads` in `webapp/chorales.py`. The chorale is identified from the page's soprano line; where the collection sets the same tune more than once, each match is tried. Each phrase is rebuilt from the legal run of chords that fits the notes best, in each style (so a misread chord is mended to a legal one instead of upsetting the rest of the phrase; in Fancy a suspension's held note counts as the chord note it falls to). The chords go to the same decoder as the Decipher tab (`scan_words` in `app.py`), whose checksum mends up to two chords and chooses between repairs that fit the page equally well. With a perfect reading of the page every message decodes, in both styles. Scan reads word messages only, not ASCII text. The page shows the words, the problems found and a MIDI download (`/scan/midi`).
 
+The Scan tab's debugging (the chorale and how many chords were corrected, the problems found, the notes read and a MIDI of the reading) is hidden. Add `?debug=1` to the page's address to see it, or start the server with `CHORALE_DEBUG=1` to show it to everyone.
+
 Debug suite (`webapp/debugdump.py`): after every scan the server writes `webapp/debug/scan-<time>/` and a copy in `webapp/debug/latest/`: the snapshot, the read-back MIDI drawn again by the renderer, the two side by side, and `dump.txt` (step health, the bars that would not add up, and note by note which beats differ from the decoded chords and why) with the same facts as `dump.json`. `/debug` shows the newest one in the browser. It is not committed.
 
 The first run builds `webapp/chorale_capacity.json` (capacity and beats of every usable chorale, about 30 seconds); the server then loads every chorale's tune in the background so the first scan is not slow. It is generated and not committed.
diff --git a/webapp/app.py b/webapp/app.py
index db09084..4a6f476 100644
--- a/webapp/app.py
+++ b/webapp/app.py
@@ -53,6 +53,14 @@ import chorales
 from scanner import Scanner
 
 app = Flask(__name__)
+#the Scan tab's debugging (what was read, the problems found, the notes, a MIDI of the reading) is hidden unless
+#CHORALE_DEBUG=1, or ?debug=1 is on the page's address
+DEBUG_UI = os.environ.get("CHORALE_DEBUG") == "1"
+
+
+@app.context_processor
+def debug_flag():
+    return {"show_debug": DEBUG_UI or (has_request_context() and request.args.get("debug") == "1")}
 app.config["MAX_CONTENT_LENGTH"] = 32 * 1024 * 1024
 
 
diff --git a/webapp/templates/index.html b/webapp/templates/index.html
index 7eb44f0..b32ab9e 100644
--- a/webapp/templates/index.html
+++ b/webapp/templates/index.html
@@ -17,6 +17,7 @@ body{background:var(--paper);color:var(--ink);font-family:var(--serif);font-size
 a{color:inherit}
 button{font:inherit;color:inherit}
 .hidden{display:none!important}
+body:not(.debug) .debug-only{display:none!important}
 
 /* header */
 header{padding:28px 56px 0;max-width:1400px;margin:0 auto}
@@ -195,7 +196,7 @@ footer{text-align:center;color:var(--faint);font-size:13px;font-style:italic;pad
 @media (prefers-reduced-motion:reduce){*{transition:none!important}}
 </style>
 </head>
-<body>
+<body{% if show_debug %} class="debug"{% endif %}>
 {% set tab = active_tab|default('encode') %}
 {% set style_value = encoding_style|default('original') %}
 {% set method_value = encoding_method|default('words') %}
@@ -379,20 +380,20 @@ footer{text-align:center;color:var(--faint);font-size:13px;font-style:italic;pad
       <div class="kicker">The hidden message</div>
       <div class="reveal">
         <div class="q" id="decodedText"></div>
-        <div id="decodedInfo" class="hint gap-m"></div>
+        <div id="decodedInfo" class="hint gap-m debug-only"></div>
       </div>
     </div>
     <div id="scan-empty" class="empty"><div class="glyph" aria-hidden="true">&#9673;</div><p>Scan a printed chorale to read its message. Only works with 3 word encoded messages.</p></div>
     <div class="scanbtns">
       <button id="again" type="button" class="dl hidden">Scan again</button>
-      <a id="midi" href="/scan/midi" download="chorale.mid" class="dl hidden">What was read · MIDI</a>
+      <a id="midi" href="/scan/midi" download="chorale.mid" class="dl hidden debug-only">What was read · MIDI</a>
     </div>
-    <ul id="warnings" class="scanlist"></ul>
-    <details id="flagsBox" class="hidden scandetails">
+    <ul id="warnings" class="scanlist debug-only"></ul>
+    <details id="flagsBox" class="hidden scandetails debug-only">
       <summary id="flagsSummary">Problems found</summary>
       <ul id="flags" class="scanlist"></ul>
     </details>
-    <details id="notesBox" class="hidden scandetails">
+    <details id="notesBox" class="hidden scandetails debug-only">
       <summary>Notes read</summary>
       <div id="notes"></div>
     </details>
@@ -652,7 +653,8 @@ document.querySelectorAll('[data-player]').forEach(box => {
     fillDetails(result);
     const decoded = result.decoded || {};
     if (decoded.text) setStatus('Message deciphered', 'ok');
-    else setStatus('Read, but not deciphered: the problems found are listed', 'warn');
+    else setStatus(document.body.classList.contains('debug') ? 'Read, but not deciphered: the problems found are listed'
+                                                               : 'Read, but not deciphered: try again with the page flat and well lit', 'warn');
   }
   //a reply that is not JSON (an error page, an empty body) is reported with its status and its first words, not as "the string did not match the
   //expected pattern" (Safari's wording for a failed JSON parse), so the real problem can be read off the screen
